{
  "name": "faculty-email-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types && wrangler types --config wrangler.print-export.jsonc --env-interface PrintExportEnv print-export-configuration.d.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:print-export": "wrangler deploy --config wrangler.print-export.jsonc --dry-run --outdir dist-print-export"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.8",
    "@types/node": "26.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
