{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faculty-email-gateway",
  "main": "src/index.ts",
  "account_id": "00000000000000000000000000000000",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "INBOX_URL": "https://intake.example.com/api/inbox/email"
  },
  "secrets": {"required": ["TEACH_INBOX_WEBHOOK_SECRET", "INTAKE_POLICIES"]},
  "r2_buckets": [{"binding": "MAIL", "bucket_name": "faculty-email-buffer"}],
  "queues": {
    "producers": [{"binding": "DELIVERIES", "queue": "faculty-email-deliveries"}],
    "consumers": [{
      "queue": "faculty-email-deliveries",
      "max_batch_size": 1,
      "max_batch_timeout": 5,
      "max_retries": 5,
      "max_concurrency": 1,
      "retry_delay": 300,
      "dead_letter_queue": "faculty-email-failed"
    }]
  },
  "triggers": {"crons": ["*/15 * * * *"]},
  "limits": {"cpu_ms": 1000},
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "invocation_logs": false},
    "traces": {"enabled": true, "head_sampling_rate": 0}
  }
}
