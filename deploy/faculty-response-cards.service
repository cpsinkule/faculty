[Unit]
Description=Reconcile Faculty Response Card submissions
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/Teaching
ExecStart=%h/code/Teaching/.venv/bin/python %h/code/Teaching/manage_response_cards.py sync
Environment=FACULTY_REQUIRE_STORAGE=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=%h/.config/faculty/response-cards.env
NoNewPrivileges=true
UMask=0077
