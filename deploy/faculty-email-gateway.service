[Unit]
Description=Faculty signed email intake gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/code/Teaching
ExecStart=%h/code/Teaching/.venv/bin/python %h/code/Teaching/email_gateway.py
EnvironmentFile=%h/.config/faculty/email.env
Environment=FACULTY_REQUIRE_STORAGE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
